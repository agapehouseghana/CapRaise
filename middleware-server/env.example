# Server Configuration
PORT=4000
NODE_ENV=development

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=capraise-43d7f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@capraise-43d7f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# External API Configuration
EXTERNAL_API_URL=https://capraise-backend.onrender.com/api/v1
EXTERNAL_API_KEY=your-external-api-key

# Webhook Configuration
KOWRI_WEBHOOK_SECRET=your-64-character-hex-webhook-secret-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://capraise.netlify.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Database
DB_CONNECTION_TIMEOUT=30000 